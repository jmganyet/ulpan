    {
      "id": "pag-30-b1",
      "pagina": "pag-30",
      "titol": {
        "u": "לְאָן?",
        "perComprovar": false,
        "ca": "Cap a on?"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-30-b1-l0",
          "text": {
            "u": "**אסתר:** יוסי, לאן אתה הולך?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-30-b1-l1",
          "text": {
            "u": "**יוסי:** אני הולך לתיאטרון, גם את באה לתיאטרון?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-30-b1-l2",
          "text": {
            "u": "**אסתר:** לא, אני הולכת לקונצרט."
          },
          "perComprovar": false
        },
        {
          "id": "pag-30-b1-l3",
          "text": {
            "u": "**יוסי:** גם דינה הולכת לקונצרט?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-30-b1-l4",
          "text": {
            "u": "**אסתר:** לא."
          },
          "perComprovar": false
        },
        {
          "id": "pag-30-b1-l5",
          "text": {
            "u": "**יוסי:** לאן היא הולכת?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-30-b1-l6",
          "text": {
            "u": "**אסתר:** היא הולכת לאולפָן. היא לומדת עברית."
          },
          "perComprovar": true
        }
      ]
    },
    {
      "id": "pag-30-b2",
      "pagina": "pag-30",
      "titol": {
        "u": "בְּ... בַּ... / לְ... לַ... (הבחנה)",
        "perComprovar": false,
        "ca": "Cap a on?"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-30-b2-l0",
          "text": {
