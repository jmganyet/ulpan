          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-31-b1",
      "pagina": "pag-31",
      "titol": {
        "u": "בַּבַּיִת / לַבַּיִת / הַבַּיְתָה (הבחנה)",
        "perComprovar": false,
        "ca": "A casa, cap a la casa, cap a casa"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-31-b1-l0",
          "text": {
            "u": "זה הבית של רחל ויעקב."
          },
          "perComprovar": false
        },
        {
          "id": "pag-31-b1-l1",
          "text": {
            "u": "איפה רחל?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-31-b1-l2",
          "text": {
            "u": "רחל בבית."
          },
          "perComprovar": false
        },
        {
          "id": "pag-31-b1-l3",
          "text": {
            "u": "לאן הולכים רוברטו ויעקב?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-31-b1-l4",
          "text": {
            "u": "רוברטו הולך לבית של רחל ויעקב."
          },
          "perComprovar": false
        },
        {
          "id": "pag-31-b1-l5",
          "text": {
            "u": "יעקב הולך הביתה."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-31-b2",
      "pagina": "pag-31",
      "titol": {
        "u": "בַּבַּיִת, לַבַּיִת, הַבַּיְתָה",
        "perComprovar": false,
        "ca": "A casa, cap a la casa, cap a casa"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-31-b2-l0",
          "text": {
            "u": "הוא ← לומד / עובד / גר"
          },
          "perComprovar": false
        },
        {
          "id": "pag-31-b2-l1",
          "text": {
