        },
        {
          "id": "pag-30-b2-l1",
          "text": {
            "u": "הוא בא לַקיבוץ בפברואר."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-30-b3",
      "pagina": "pag-30",
      "titol": {
        "u": "בְּ... בַּ... / לְ... לַ... (הבחנה)",
        "perComprovar": false,
