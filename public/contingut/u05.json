  "textos": [
    {
      "id": "pag-28-b0",
      "pagina": "pag-28",
      "titol": {
        "u": "בָּאוּלְפָּן בְּקִיבּוּץ דָּן",
        "perComprovar": true,
        "ca": "A l'ulpan del quibuts Dan"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-28-b0-l0",
          "text": {
            "u": "איפה אתה גר, רוברטו?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-28-b0-l1",
          "text": {
            "u": "אני גר בקיבוץ דן בגליל."
          },
          "perComprovar": false
        },
        {
          "id": "pag-28-b0-l2",
          "text": {
            "u": "בגליל יש הרבה קיבוצים?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-28-b0-l3",
          "text": {
            "u": "כן, בגליל יש הרבה קיבוצים."
          },
          "perComprovar": false
        },
        {
          "id": "pag-28-b0-l4",
          "text": {
            "u": "גם בדרום-אמריקה יש קיבוצים?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-28-b0-l5",
          "text": {
            "u": "לא, בדרום-אמריקה אין קיבוצים."
          },
          "perComprovar": false
        },
        {
          "id": "pag-28-b0-l6",
          "text": {
            "u": "בקיבוץ דן יש אולפן?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-28-b0-l7",
          "text": {
            "u": "כן, בקיבוץ דן יש אולפן-עבודה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-28-b0-l8",
          "text": {
            "u": "אתה לומד באולפן בקיבוץ דן?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-28-b0-l9",
          "text": {
            "u": "כן, אני לומד שם."
          },
          "perComprovar": false
        },
        {
          "id": "pag-28-b0-l10",
          "text": {
            "u": "באולפן יש הרבה כיתות?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-28-b0-l11",
          "text": {
            "u": "לא, באולפן, בקיבוץ דן יש רק שלוש כיתות."
          },
          "perComprovar": false
        },
        {
          "id": "pag-28-b0-l12",
          "text": {
            "u": "יש באולפן הרבה תלמידים מארצות-הברית?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-28-b0-l13",
          "text": {
            "u": "לא, מארצות-הברית אין הרבה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-28-b0-l14",
          "text": {
            "u": "ומברזיל?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-28-b0-l15",
          "text": {
            "u": "גם מברזיל יש רק מעט תלמידים."
          },
          "perComprovar": false
        },
        {
          "id": "pag-28-b0-l16",
          "text": {
            "u": "באולפן יש מורים, או מורות?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-28-b0-l17",
          "text": {
            "u": "באולפן בקיבוץ דן יש רק מורות."
          },
          "perComprovar": false
        },
        {
          "id": "pag-28-b0-l18",
          "text": {
            "u": "הכיתה גדולה? היא יפה?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-28-b0-l19",
          "text": {
            "u": "ככה-ככה."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-29-b0",
      "pagina": "pag-29",
      "titol": {
        "u": "הַפְּעָלִים הַחֲדָשִׁים",
        "perComprovar": false,
        "ca": "Els verbs nous"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-29-b0-l0",
          "text": {
            "u": "מה יש בכיתה?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-29-b0-l1",
          "text": {
            "u": "סליחה, עכשיו יש שיעור. שלום! אני הולך לכיתה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-29-b0-l2",
          "text": {
            "u": "גם אתה בא לכיתה?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-29-b0-l3",
          "text": {
            "u": "לא."
          },
          "perComprovar": false
        },
        {
          "id": "pag-29-b0-l4",
          "text": {
            "u": "לאן אתה הולך?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-29-b0-l5",
          "text": {
            "u": "אני הולך הביתה. להתראות!"
          },
          "perComprovar": false
        },
        {
          "id": "pag-29-b0-l6",
          "text": {
            "u": "להתראות!"
          },
          "perComprovar": false
        }
      ]
    },
    {
