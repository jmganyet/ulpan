      "tipus": "text",
      "linies": [
        {
          "id": "pag-44-b0-l0",
          "text": {
            "u": "יצחק לא יודע עברית, הוא רוצה לָדַעַת עברית."
          },
          "perComprovar": false
        },
        {
          "id": "pag-44-b0-l1",
          "text": {
            "u": "יצחק לא מבין עברית, הוא רוצה לְהָבִין עברית."
          },
          "perComprovar": false
        },
        {
          "id": "pag-44-b0-l2",
          "text": {
            "u": "יצחק רוצה ללמוד לְדַבֵּר, לִקרוא וְלִכתוב עברית."
          },
          "perComprovar": false
        }
      ]
    },
