  "gramatica": [],
  "textos": [
    {
      "id": "pag-02-b0",
      "pagina": "pag-02",
      "titol": {
        "u": "Diàleg",
        "perComprovar": false,
        "ca": "Coneixença"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-02-b0-l0",
          "text": {
            "u": "**רוברטו:** שלום, אני רוברטו."
          },
          "perComprovar": false
        },
        {
          "id": "pag-02-b0-l1",
          "text": {
            "u": "**דוריס:** אני דוריס."
          },
          "perComprovar": false
        },
        {
          "id": "pag-02-b0-l2",
          "text": {
            "u": "**רוברטו:** נעים מאוד."
          },
          "perComprovar": false
        },
        {
          "id": "pag-02-b0-l3",
          "text": {
            "u": "**דוריס:** נעים מאוד. אתה תלמיד?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-02-b0-l4",
          "text": {
            "u": "**רוברטו:** כן, אני תלמיד. את תלמידה?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-02-b0-l5",
          "text": {
            "u": "**דוריס:** כן, אני תלמידה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-02-b0-l6",
          "text": {
            "u": "**רוברטו:** את עולה חדשה?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-02-b0-l7",
          "text": {
            "u": "**דוריס:** לא, אני לא עולה חדשה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-02-b0-l8",
          "text": {
            "u": "אני תיירת. אני תיירת מֵאַנְגְלִיָּה."
          },
          "perComprovar": true
        },
        {
          "id": "pag-02-b0-l9",
          "text": {
            "u": "אתה תייר?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-02-b0-l10",
          "text": {
            "u": "**רוברטו:** לא, אני לא תייר. סטיב תייר."
          },
          "perComprovar": false
        },
        {
          "id": "pag-02-b0-l11",
          "text": {
            "u": "**דוריס:** ואתה?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-02-b0-l12",
          "text": {
            "u": "**רוברטו:** אני עולה חדש מִבְּרָזִיל."
          },
          "perComprovar": true
        }
      ]
    },
    {
      "id": "pag-02-b1",
      "pagina": "pag-02",
      "titol": {
        "u": "Taula",
        "perComprovar": false,
        "ca": "Coneixença"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-02-b1-l0",
          "text": {
            "u": "הוּא · רוברטו תלמיד. · הוא עולה חדש. · הוא לא תייר."
          },
          "perComprovar": false
        },
        {
          "id": "pag-02-b1-l1",
          "text": {
            "u": "הִיא · דוריס תלמידה. · היא לא עולה חדשה. · היא תיירת."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-03-b0",
      "pagina": "pag-03",
      "titol": {
        "u": "מִי אַתָּה?",
        "perComprovar": false,
        "ca": "Qui ets?"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-03-b0-l0",
          "text": {
            "u": "מִי אַתָּה?"
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-03-b1",
      "pagina": "pag-03",
      "titol": {
        "u": "מי אתה?",
        "perComprovar": false,
        "ca": "Qui ets?"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-03-b1-l0",
          "text": {
            "u": "אני יִצְחָק לֵוִי."
          },
          "perComprovar": true
        },
        {
          "id": "pag-03-b1-l1",
          "text": {
            "u": "אדון לֵוִי, אתה מוֹרֶה?"
          },
          "perComprovar": true
        },
        {
          "id": "pag-03-b1-l2",
          "text": {
            "u": "לא, אני לא מוֹרֶה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-03-b1-l3",
          "text": {
            "u": "יוֹסֵף מוֹרֶה. הוא מורה טוב."
          },
          "perComprovar": true
        },
        {
          "id": "pag-03-b1-l4",
          "text": {
            "u": "אתה תלמיד טוב?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-03-b1-l5",
          "text": {
            "u": "כן, אני תלמיד טוב."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-03-b2",
      "pagina": "pag-03",
      "titol": {
        "u": "מי את?",
        "perComprovar": false,
        "ca": "Qui ets?"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-03-b2-l0",
          "text": {
            "u": "אני שָׂרָה לוי."
          },
          "perComprovar": false
        },
        {
          "id": "pag-03-b2-l1",
          "text": {
            "u": "גברת לוי, את מוֹרָה?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-03-b2-l2",
          "text": {
            "u": "לא, אני לא מוֹרָה. אני תלמידה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-03-b2-l3",
          "text": {
            "u": "דְּבוֹרָה מוֹרָה. היא מורה טובה."
          },
          "perComprovar": true
        },
        {
          "id": "pag-03-b2-l4",
          "text": {
            "u": "את תלמידה טובה?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-03-b2-l5",
          "text": {
            "u": "לא, אני תלמידה לא טובה."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-04-b0",
      "pagina": "pag-04",
      "titol": {
        "u": "מי הוא?",
        "perComprovar": false,
        "ca": "Qui és ell? Qui és ella?"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-04-b0-l0",
          "text": {
            "u": "הוא סטיב."
          },
          "perComprovar": false
        },
        {
          "id": "pag-04-b0-l1",
          "text": {
            "u": "סטיב עוֹלֶה חדש?"
          },
          "perComprovar": true
        },
        {
          "id": "pag-04-b0-l2",
          "text": {
            "u": "לא, הוא תַּיָּר מֵאַנְגְלִיָּה."
          },
          "perComprovar": true
        },
        {
          "id": "pag-04-b0-l3",
          "text": {
            "u": "סטיב חבר שֶׁל דוריס?"
          },
          "perComprovar": true
        },
        {
          "id": "pag-04-b0-l4",
          "text": {
            "u": "כן, הוא חבר של דוריס."
          },
          "perComprovar": false
        },
        {
          "id": "pag-04-b0-l5",
          "text": {
            "u": "סטיב חבר טוב?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-04-b0-l6",
          "text": {
            "u": "כן, סטיב חבר טוב מאוד."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-04-b1",
      "pagina": "pag-04",
      "titol": {
        "u": "מי היא?",
        "perComprovar": false,
        "ca": "Qui és ell? Qui és ella?"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-04-b1-l0",
          "text": {
            "u": "היא דוריס."
          },
          "perComprovar": false
        },
        {
          "id": "pag-04-b1-l1",
          "text": {
            "u": "דוריס עוֹלָה חדשה?"
          },
          "perComprovar": true
        },
        {
          "id": "pag-04-b1-l2",
          "text": {
            "u": "לא, גם היא תַּיֶּרֶת מֵאַנְגְלִיָּה."
          },
          "perComprovar": true
