      "tipus": "text",
      "linies": [
        {
          "id": "pag-39-b1-l0",
          "text": {
            "u": "1. [המוֹרָה] עומדת על-יד הלוח וכותבת בגיר."
          },
          "perComprovar": false
        },
        {
          "id": "pag-39-b1-l1",
          "text": {
            "u": "(המוֹרֶה, הם, התלמידות)"
          },
          "perComprovar": false
        },
        {
          "id": "pag-39-b1-l2",
          "text": {
            "u": "2. יצחק עומד [פה]."
          },
          "perComprovar": false
        },
        {
          "id": "pag-39-b1-l3",
          "text": {
            "u": "(שם, על-יד החלון, בכיתה, בין החלון והדלת)"
          },
          "perComprovar": false
        },
        {
          "id": "pag-39-b1-l4",
          "text": {
            "u": "3. [הוא] אומר \"שלום\" ויושב."
          },
          "perComprovar": false
        },
        {
          "id": "pag-39-b1-l5",
          "text": {
            "u": "(דני ואני, שׂרה ודוריס, המוֹרָה)"
          },
          "perComprovar": false
        },
        {
          "id": "pag-39-b1-l6",
          "text": {
            "u": "4. מה [אתה] אומר?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-39-b1-l7",
          "text": {
            "u": "(את, אתם, הילדות)"
          },
          "perComprovar": false
        },
        {
          "id": "pag-39-b1-l8",
          "text": {
            "u": "5. סטיב אומר ש[אסתר יפה]."
          },
          "perComprovar": false
        },
        {
          "id": "pag-39-b1-l9",
          "text": {
            "u": "(הם בבית, השיעור מעניין, החדר יפה)"
          },
          "perComprovar": false
        },
        {
          "id": "pag-39-b1-l10",
          "text": {
            "u": "6. חנה כותבת [בעט]."
          },
          "perComprovar": false
        },
        {
          "id": "pag-39-b1-l11",
          "text": {
            "u": "(בעיפרון, במחברת, על הלוח, לַהורים)"
          },
          "perComprovar": true
        }
      ]
    }
