        "perComprovar": false,
        "ca": "Els verbs nous"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-37-b2-l0",
          "text": {
            "u": "מי עומד על-יד הדלת?"
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-37-b3",
      "pagina": "pag-37",
      "titol": {
        "u": "הפעלים החדשים",
        "perComprovar": false,
        "ca": "Els verbs nous"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-37-b3-l0",
          "text": {
            "u": "יצחק עומד על-יד הדלת. המורה אומרת:"
          },
          "perComprovar": false
        },
        {
          "id": "pag-37-b3-l1",
          "text": {
            "u": "\"בוקר טוב יצחק! הנה כיסא. בבקשה לשבת!\""
          },
          "perComprovar": false
        },
        {
          "id": "pag-37-b3-l2",
          "text": {
            "u": "\"בוקר טוב\" אומר יצחק ויושב."
          },
          "perComprovar": false
        },
        {
          "id": "pag-37-b3-l3",
          "text": {
            "u": "עכשיו גם יצחק לומד. עכשיו גם יצחק כותב."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-37-b4",
      "pagina": "pag-37",
      "titol": {
        "u": "בְּ",
        "perComprovar": false,
        "ca": "Els verbs nous"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-37-b4-l0",
          "text": {
            "u": "המורה כותבת בְּגיר. התלמיד כותב בעט."
