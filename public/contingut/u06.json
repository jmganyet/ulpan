      "tipus": "text",
      "linies": [
        {
          "id": "pag-35-b1-l0",
          "text": {
            "u": "1. הגיטרה ____ השטיח ____ השולחן."
          },
          "perComprovar": false
        },
        {
          "id": "pag-35-b1-l1",
          "text": {
            "u": "2. השטיח ____ הגיטרה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-35-b1-l2",
          "text": {
            "u": "3. השולחן ____ הכיסא והמיטה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-35-b1-l3",
          "text": {
            "u": "4. הטלוויזיה ____ הארון ____ הטרנזיסטור."
          },
          "perComprovar": false
        },
        {
          "id": "pag-35-b1-l4",
          "text": {
            "u": "5. החתול ____ החלון. הכלב ____ המיטה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-35-b1-l5",
          "text": {
            "u": "6. המיטה ____ השולחן. הספר ____ המיטה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-35-b1-l6",
          "text": {
            "u": "7. העיפרון ____ העט והטלפון."
          },
          "perComprovar": false
        },
        {
          "id": "pag-35-b1-l7",
          "text": {
            "u": "8. העט ____ השולחן. המחברת ____ העט."
          },
          "perComprovar": false
        },
        {
          "id": "pag-35-b1-l8",
          "text": {
            "u": "9. העט ____ המחברת והעפרון."
          },
          "perComprovar": false
        },
        {
          "id": "pag-35-b1-l9",
          "text": {
            "u": "10. הילדה והאיש ____ הדלת."
          },
          "perComprovar": false
        },
        {
          "id": "pag-35-b1-l10",
          "text": {
            "u": "11. הטרנזיסטור ____ הטלוויזיה ____ הארון."
