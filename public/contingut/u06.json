          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-36-b0",
      "pagina": "pag-36",
      "titol": {
        "u": "בַּכִּיתָה",
        "perComprovar": false,
        "ca": "A la classe"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-36-b0-l0",
          "text": {
            "u": "זאת כיתה באולפן. מה יש בכיתה?"
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-36-b1",
      "pagina": "pag-36",
      "titol": {
        "u": "בַּכִּיתָה",
        "perComprovar": false,
        "ca": "A la classe"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-36-b1-l0",
          "text": {
            "u": "בכיתה יש שולחן. על השולחן יש ספר, מחברת ועט."
          },
          "perComprovar": false
        },
        {
          "id": "pag-36-b1-l1",
          "text": {
            "u": "בכיתה יש לוח גדול שחור, חלונות גדולים ודלת."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-36-b2",
      "pagina": "pag-36",
      "titol": {
        "u": "בַּכִּיתָה",
        "perComprovar": false,
        "ca": "A la classe"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-36-b2-l0",
          "text": {
            "u": "יש בכיתה טלוויזיה?"
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-36-b3",
      "pagina": "pag-36",
      "titol": {
        "u": "בַּכִּיתָה",
        "perComprovar": false,
        "ca": "A la classe"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-36-b3-l0",
          "text": {
            "u": "לא, טלוויזיה יש במועדון של האולפן."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-36-b4",
      "pagina": "pag-36",
      "titol": {
        "u": "בַּכִּיתָה",
        "perComprovar": false,
        "ca": "A la classe"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-36-b4-l0",
          "text": {
            "u": "וטלפון יש בכיתה?"
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-36-b5",
      "pagina": "pag-36",
      "titol": {
        "u": "בַּכִּיתָה",
        "perComprovar": false,
        "ca": "A la classe"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-36-b5-l0",
          "text": {
            "u": "לא. גם טלפון אין בכיתה. טלפון יש במשרד."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-36-b6",
      "pagina": "pag-36",
      "titol": {
        "u": "בַּכִּיתָה",
        "perComprovar": false,
        "ca": "A la classe"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-36-b6-l0",
          "text": {
            "u": "יש פה כיסא?"
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-36-b7",
      "pagina": "pag-36",
      "titol": {
        "u": "בַּכִּיתָה",
        "perComprovar": false,
        "ca": "A la classe"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-36-b7-l0",
          "text": {
            "u": "יש פה הרבה כיסאות."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-36-b8",
      "pagina": "pag-36",
      "titol": {
        "u": "בַּכִּיתָה",
        "perComprovar": false,
        "ca": "A la classe"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-36-b8-l0",
          "text": {
            "u": "ואיפה התלמידים? מה הם עושים?"
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-36-b9",
      "pagina": "pag-36",
      "titol": {
        "u": "בַּכִּיתָה",
        "perComprovar": false,
        "ca": "A la classe"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-36-b9-l0",
          "text": {
            "u": "התלמידים בכיתה. הם יושבים על הכסאות ולומדים."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-36-b10",
      "pagina": "pag-36",
      "titol": {
        "u": "בַּכִּיתָה",
        "perComprovar": false,
        "ca": "A la classe"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-36-b10-l0",
          "text": {
            "u": "איפה המורה? מה היא עושה?"
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-36-b11",
      "pagina": "pag-36",
      "titol": {
        "u": "בַּכִּיתָה",
        "perComprovar": false,
        "ca": "A la classe"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-36-b11-l0",
          "text": {
            "u": "גם היא בכיתה. היא עומדת על-יד הלוח וכותבת על הלוח בגיר לבן. היא כותבת על הלוח מילים חדשות."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-37-b0",
      "pagina": "pag-37",
      "titol": {
        "u": "הפעלים החדשים",
        "perComprovar": false,
        "ca": "Els verbs nous"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-37-b0-l0",
          "text": {
            "u": "גם התלמידים כותבים על הלוח בגיר?"
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-37-b1",
      "pagina": "pag-37",
      "titol": {
        "u": "הפעלים החדשים",
        "perComprovar": false,
        "ca": "Els verbs nous"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-37-b1-l0",
          "text": {
            "u": "לא, הם כותבים במחברות בעיפרון, או בעט."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-37-b2",
      "pagina": "pag-37",
      "titol": {
