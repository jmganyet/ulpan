      "tipus": "text",
      "linies": [
        {
          "id": "pag-52-b0-l0",
          "text": {
            "u": "מַתְחִיל · מַתְחִילָה · מַתְחִילִים · מַתְחִילוֹת · לְהַתְחִיל"
          },
          "perComprovar": false,
