        "ca": "Preguntar; exercici 30"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-53-b0-l0",
          "text": {
            "u": "אומרים: המורה שואלת והתלמידים עונים."
          },
          "perComprovar": false
        },
        {
          "id": "pag-53-b0-l1",
          "text": {
            "u": "הוא שואל הרבה שאלות."
          },
          "perComprovar": false
        },
        {
          "id": "pag-53-b0-l2",
          "text": {
            "u": "אבל: המורה שואלת אֶת רוברטו."
          },
          "perComprovar": false
        },
        {
          "id": "pag-53-b0-l3",
          "text": {
            "u": "המורה שואלת אֶת הַתלמידים."
          },
          "perComprovar": false
        }
      ]
    },
