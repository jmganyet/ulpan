  "gramatica": [],
  "textos": [
    {
      "id": "pag-50-b0",
      "pagina": "pag-50",
      "titol": {
        "u": "שִׁעור בַּכִּתָּה שֶׁל רובֶּרטו",
        "perComprovar": true,
        "ca": "Classe a l'aula d'en Roberto"
      },
      "tipus": "dialeg",
      "personatges": [
        "מורה",
        "תלמידים",
        "יוסף",
        "עמנואל",
        "סטיב"
      ],
      "linies": [
        {
          "id": "pag-50-b0-l0",
          "text": {
            "u": "בוקר טוב, תלמידים!"
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "f505968ef4b3.m4a",
            "lent": "7249c1c62365.m4a"
          }
        },
        {
          "id": "pag-50-b0-l1",
          "text": {
            "u": "בוקר טוב!"
          },
          "perComprovar": false,
          "qui": "תלמידים",
          "audio": {
            "normal": "2ddfbb441342.m4a",
            "lent": "69529a73e9d0.m4a"
          }
        },
        {
          "id": "pag-50-b0-l2",
          "text": {
            "u": "מדוע שושנה לא באה היום?"
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "548f1d844049.m4a",
            "lent": "4ce77285c088.m4a"
          }
        },
        {
          "id": "pag-50-b0-l3",
          "text": {
            "u": "כי היא חולה."
          },
          "perComprovar": false,
          "qui": "תלמידים",
          "audio": {
            "normal": "ffa57b0ce4e8.m4a",
            "lent": "c9a94ebd9893.m4a"
          }
        },
        {
          "id": "pag-50-b0-l4",
          "text": {
            "u": "ואיפה דוריס?"
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "383b0801ce8c.m4a",
            "lent": "3829255c115c.m4a"
          }
        },
        {
          "id": "pag-50-b0-l5",
          "text": {
            "u": "אנחנו לא יודעים."
          },
          "perComprovar": false,
          "qui": "תלמידים",
          "audio": {
            "normal": "d01baf76bb8e.m4a",
            "lent": "a26a5b6a4b76.m4a"
          }
        },
        {
          "id": "pag-50-b0-l6",
          "text": {
            "u": "גם יוסף חסר."
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "c91b6aec4dbd.m4a",
            "lent": "aaa4771c5da6.m4a"
          }
        },
        {
          "id": "pag-50-b0-l7",
          "text": {
            "u": "לא, אני פה!"
          },
          "perComprovar": false,
          "qui": "יוסף",
          "audio": {
            "normal": "f1a49bcb2ec1.m4a",
            "lent": "f5356b45bf4a.m4a"
          }
        },
        {
          "id": "pag-50-b0-l8",
          "text": {
            "u": "יפה מאוד! מה זה שם?"
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "e0c3c4ef8d9a.m4a",
            "lent": "fa968ddc3f09.m4a"
          }
        },
        {
          "id": "pag-50-b0-l9",
          "text": {
            "u": "רוברטו ועמנואל, שקט בבקשה! מדוע אתם מדברים?"
          },
          "perComprovar": false,
          "audio": {
            "normal": "23fcc20935ca.m4a",
            "lent": "5f2078499718.m4a"
          }
        },
        {
          "id": "pag-50-b0-l10",
          "text": {
            "u": "אנחנו לא מדברים."
          },
          "perComprovar": false,
          "qui": "עמנואל",
          "audio": {
            "normal": "a04427fd4bb4.m4a",
            "lent": "c94a7f56bcd6.m4a"
          }
        },
        {
          "id": "pag-50-b0-l11",
          "text": {
            "u": "מצוין. אנחנו מתחילים. אני כותבת שאלות על הלוח"
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "a3b8d41049bb.m4a",
            "lent": "c4474e985d08.m4a"
          }
        },
        {
          "id": "pag-50-b0-l12",
          "text": {
            "u": "ואתם עונים. אתם כותבים תשובות במחברות."
          },
          "perComprovar": false,
          "audio": {
            "normal": "38a8e74fb033.m4a",
            "lent": "2fb618551693.m4a"
          }
        },
        {
          "id": "pag-50-b0-l13",
          "text": {
            "u": "סליחה, המורה, אני לא מבין."
          },
          "perComprovar": false,
          "qui": "עמנואל",
          "audio": {
            "normal": "a300a3e3a29a.m4a",
            "lent": "db820fdfdcca.m4a"
          }
        },
        {
          "id": "pag-50-b0-l14",
          "text": {
            "u": "בבקשה להגיד עוד פעם."
          },
          "perComprovar": false,
          "audio": {
            "normal": "2c42df748634.m4a",
            "lent": "dd83eaec21f7.m4a"
          }
        },
        {
          "id": "pag-50-b0-l15",
          "text": {
            "u": "סטיב, אתה מבין מה שאני אומרת?"
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "c142e2e47d69.m4a",
            "lent": "a1121f9b81cc.m4a"
          }
        },
        {
          "id": "pag-50-b0-l16",
          "text": {
            "u": "כן, אני מבין הכול."
          },
          "perComprovar": false,
          "qui": "סטיב",
          "audio": {
            "normal": "c5d90386cd3b.m4a",
            "lent": "e48d15e33bfd.m4a"
          }
        },
        {
          "id": "pag-50-b0-l17",
          "text": {
            "u": "עמנואל, סטיב מבין הכול. הוא לא מדבר עם חבר..."
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "e49d71730586.m4a",
            "lent": "7a0341cf4358.m4a"
          }
        },
        {
          "id": "pag-50-b0-l18",
          "text": {
            "u": "עמנואל! אתה לא יכול לשבת בשקט?"
          },
          "perComprovar": false,
          "audio": {
            "normal": "92d8c28a42cd.m4a",
            "lent": "a78bb32079fa.m4a"
          }
        },
        {
          "id": "pag-50-b0-l19",
          "text": {
            "u": "הנה דוריס."
          },
          "perComprovar": false,
          "qui": "סטיב",
          "audio": {
            "normal": "6fafe9ec8c7c.m4a",
            "lent": "225934eeaad9.m4a"
          }
        }
      ]
    },
    {
      "id": "pag-51-b0",
      "pagina": "pag-51",
      "titol": {
        "u": "שיעור בכיתה של רוברטו (המשך)",
        "perComprovar": false,
        "ca": "Classe a l'aula d'en Roberto (continuació)"
      },
      "tipus": "dialeg",
      "personatges": [
        "מורה",
        "דוריס",
        "עמנואל"
      ],
      "linies": [
        {
          "id": "pag-51-b0-l0",
          "text": {
            "u": "בוקר טוב, דוריס. עכשיו את באה?"
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "57fc3f31881d.m4a",
            "lent": "5d25159f545b.m4a"
          }
        },
        {
          "id": "pag-51-b0-l1",
          "text": {
            "u": "סליחה.... האוטובוס...."
          },
          "perComprovar": false,
          "qui": "דוריס",
          "audio": {
            "normal": "7e6bb49e83a0.m4a",
            "lent": "66116f765df2.m4a"
          }
        },
        {
          "id": "pag-51-b0-l2",
          "text": {
            "u": "בבקשה להיכנס. יש מקום על-יד רוברטו."
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "336989a75241.m4a",
            "lent": "e46fbbbd8681.m4a"
          }
        },
        {
          "id": "pag-51-b0-l3",
          "text": {
            "u": "(דוריס נכנסת ויושבת)."
          },
          "perComprovar": false,
          "audio": {
            "normal": "3c9af1a9fd69.m4a",
            "lent": "f169092c764d.m4a"
          }
        },
        {
          "id": "pag-51-b0-l4",
          "text": {
            "u": "חברים, אנחנו ממשיכים. על הלוח יש שאלות."
          },
          "perComprovar": false,
          "audio": {
            "normal": "dd1403baa468.m4a",
            "lent": "c71ca6c965d5.m4a"
          }
        },
        {
          "id": "pag-51-b0-l5",
          "text": {
            "u": "אתם צריכים לכתוב תשובות במחברות."
          },
          "perComprovar": false,
          "audio": {
            "normal": "daa782d72313.m4a",
            "lent": "46732665ce33.m4a"
          }
        },
        {
          "id": "pag-51-b0-l6",
          "text": {
            "u": "יש שאלות?"
          },
          "perComprovar": false,
          "audio": {
            "normal": "b2d0ed65f25f.m4a",
            "lent": "561b56bd9b02.m4a"
          }
        },
        {
          "id": "pag-51-b0-l7",
          "text": {
            "u": "כן, אני רוצה לשאול שאלה."
          },
          "perComprovar": false,
          "qui": "עמנואל",
          "audio": {
            "normal": "de6d39e522e5.m4a",
            "lent": "8ba928450ad3.m4a"
          }
        },
        {
          "id": "pag-51-b0-l8",
          "text": {
            "u": "יפה מאוד. בבקשה לשאול."
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "8d1ac64bcda8.m4a",
            "lent": "589008f64f4f.m4a"
          }
        },
        {
          "id": "pag-51-b0-l9",
          "text": {
            "u": "אני רוצה לשאול מתי יש הפסקה?"
          },
          "perComprovar": false,
          "qui": "עמנואל",
          "audio": {
            "normal": "bab8ef0163c4.m4a",
            "lent": "c4fd20c6802a.m4a"
          }
        }
      ]
    },
    {
      "id": "pag-51-b1",
      "pagina": "pag-51",
      "titol": {
        "u": "שיעור בכיתה של רוברטו (המשך)",
