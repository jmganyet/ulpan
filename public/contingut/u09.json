    {
      "id": "pag-52-b1",
      "pagina": "pag-52",
      "titol": {
        "u": "בבקשה + שם הפועל",
        "perComprovar": false,
        "ca": "Els verbs nous"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-52-b1-l0",
          "text": {
            "u": "המורה אומרת: \"בבקשה לשאול\" והתלמידים שואלים."
          },
          "perComprovar": false,
          "audio": {
            "normal": "0a9f7928b013.m4a",
            "lent": "211e5c9246b7.m4a"
          }
        },
        {
          "id": "pag-52-b1-l1",
          "text": {
            "u": "היא אומרת: \"בבקשה להיכנס\" ודוריס נכנסת."
          },
          "perComprovar": false,
          "audio": {
            "normal": "02fd2e140297.m4a",
            "lent": "c4893393ff9b.m4a"
          }
        },
        {
          "id": "pag-52-b1-l2",
          "text": {
            "u": "אומרים: בבקשה לשבת, בבקשה לא לדבר,"
          },
          "perComprovar": false,
          "audio": {
            "normal": "3c46b95eef23.m4a",
            "lent": "48c7e2ccc211.m4a"
          }
        },
        {
          "id": "pag-52-b1-l3",
          "text": {
            "u": "בבקשה לכתוב, בבקשה להמשיך וכו' (וכולי)"
          },
          "perComprovar": false,
          "audio": {
            "normal": "4043bbde1661.m4a",
            "lent": "21099aafbc8d.m4a"
          }
        }
      ]
    },
    {
      "id": "pag-53-b0",
      "pagina": "pag-53",
      "titol": {
        "u": "שואל",
        "perComprovar": false,
        "ca": "Preguntar; exercici 30"
