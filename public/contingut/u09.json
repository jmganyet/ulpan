      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-52-b1-l0",
          "text": {
            "u": "המורה אומרת: \"בבקשה לשאול\" והתלמידים שואלים."
          },
          "perComprovar": false
        },
        {
          "id": "pag-52-b1-l1",
          "text": {
            "u": "היא אומרת: \"בבקשה להיכנס\" ודוריס נכנסת."
          },
          "perComprovar": false
        },
        {
          "id": "pag-52-b1-l2",
          "text": {
            "u": "אומרים: בבקשה לשבת, בבקשה לא לדבר,"
          },
          "perComprovar": false
        },
        {
