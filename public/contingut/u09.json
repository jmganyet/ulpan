    {
      "id": "pag-52-b1",
      "pagina": "pag-52",
      "titol": {
        "u": "בבקשה + שם הפועל",
        "perComprovar": false,
        "ca": "Els verbs nous"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-52-b1-l0",
          "text": {
            "u": "המורה אומרת: \"בבקשה לשאול\" והתלמידים שואלים."
          },
          "perComprovar": false,
          "audio": {
            "normal": "1ac51e86adc6.m4a",
            "lent": "1ac51e86adc6.m4a"
          }
        },
        {
          "id": "pag-52-b1-l1",
          "text": {
            "u": "היא אומרת: \"בבקשה להיכנס\" ודוריס נכנסת."
          },
          "perComprovar": false,
          "audio": {
            "normal": "baa99086318f.m4a",
            "lent": "baa99086318f.m4a"
          }
        },
        {
          "id": "pag-52-b1-l2",
          "text": {
            "u": "אומרים: בבקשה לשבת, בבקשה לא לדבר,"
          },
          "perComprovar": false,
          "audio": {
            "normal": "2941e91ebf46.m4a",
            "lent": "2941e91ebf46.m4a"
          }
        },
        {
          "id": "pag-52-b1-l3",
          "text": {
            "u": "בבקשה לכתוב, בבקשה להמשיך וכו' (וכולי)"
          },
          "perComprovar": false,
          "audio": {
            "normal": "b5c46bb59970.m4a",
            "lent": "b5c46bb59970.m4a"
          }
        }
      ]
    },
    {
      "id": "pag-53-b0",
      "pagina": "pag-53",
      "titol": {
        "u": "שואל",
        "perComprovar": false,
        "ca": "Preguntar; exercici 30"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-53-b0-l0",
          "text": {
            "u": "אומרים: המורה שואלת והתלמידים עונים."
          },
          "perComprovar": false,
          "audio": {
            "normal": "b6c490c7a00a.m4a",
            "lent": "b6c490c7a00a.m4a"
          }
        },
        {
          "id": "pag-53-b0-l1",
          "text": {
            "u": "הוא שואל הרבה שאלות."
          },
          "perComprovar": false,
          "audio": {
            "normal": "20f8099ad095.m4a",
            "lent": "20f8099ad095.m4a"
          }
        },
        {
          "id": "pag-53-b0-l2",
          "text": {
            "u": "אבל: המורה שואלת אֶת רוברטו."
          },
          "perComprovar": false,
          "audio": {
            "normal": "9fb967b80fde.m4a",
            "lent": "9fb967b80fde.m4a"
          }
        },
        {
          "id": "pag-53-b0-l3",
          "text": {
            "u": "המורה שואלת אֶת הַתלמידים."
          },
          "perComprovar": false,
          "audio": {
            "normal": "6056da07ddd5.m4a",
            "lent": "6056da07ddd5.m4a"
          }
        }
      ]
    },
