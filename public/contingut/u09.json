          "perComprovar": false,
          "audio": {
            "normal": "3ddfe59bb339.m4a",
            "lent": "4737e06a17d2.m4a"
          }
        },
        {
          "id": "pag-53-b0-l1",
          "text": {
            "u": "הוא שואל הרבה שאלות."
          },
          "perComprovar": false,
          "audio": {
            "normal": "d137d6585055.m4a",
            "lent": "6dadf1cd215d.m4a"
          }
        },
        {
          "id": "pag-53-b0-l2",
          "text": {
            "u": "אבל: המורה שואלת אֶת רוברטו."
          },
          "perComprovar": false,
          "audio": {
            "normal": "f4397b191277.m4a",
            "lent": "7e1389114b33.m4a"
          }
        },
        {
          "id": "pag-53-b0-l3",
          "text": {
            "u": "המורה שואלת אֶת הַתלמידים."
          },
          "perComprovar": false,
          "audio": {
            "normal": "c0ba350f803a.m4a",
            "lent": "80e18736da6d.m4a"
          }
        }
      ]
    },
