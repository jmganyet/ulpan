  "textos": [
    {
      "id": "pag-50-b0",
      "pagina": "pag-50",
      "titol": {
        "u": "שִׁעור בַּכִּתָּה שֶׁל רובֶּרטו",
        "perComprovar": true,
        "ca": "Classe a l'aula d'en Roberto"
      },
      "tipus": "dialeg",
      "personatges": [
        "מורה",
        "תלמידים",
        "יוסף",
        "עמנואל",
        "סטיב"
      ],
      "linies": [
        {
          "id": "pag-50-b0-l0",
          "text": {
            "u": "בוקר טוב, תלמידים!"
          },
          "perComprovar": false,
          "qui": "מורה"
        },
        {
          "id": "pag-50-b0-l1",
          "text": {
            "u": "בוקר טוב!"
          },
          "perComprovar": false,
          "qui": "תלמידים"
        },
        {
          "id": "pag-50-b0-l2",
          "text": {
            "u": "מדוע שושנה לא באה היום?"
          },
          "perComprovar": false,
          "qui": "מורה"
        },
        {
          "id": "pag-50-b0-l3",
          "text": {
            "u": "כי היא חולה."
          },
          "perComprovar": false,
          "qui": "תלמידים"
        },
        {
          "id": "pag-50-b0-l4",
          "text": {
            "u": "ואיפה דוריס?"
          },
          "perComprovar": false,
          "qui": "מורה"
        },
        {
          "id": "pag-50-b0-l5",
          "text": {
            "u": "אנחנו לא יודעים."
          },
          "perComprovar": false,
          "qui": "תלמידים"
        },
        {
          "id": "pag-50-b0-l6",
          "text": {
            "u": "גם יוסף חסר."
          },
          "perComprovar": false,
          "qui": "מורה"
        },
        {
          "id": "pag-50-b0-l7",
          "text": {
            "u": "לא, אני פה!"
          },
          "perComprovar": false,
          "qui": "יוסף"
        },
        {
          "id": "pag-50-b0-l8",
          "text": {
            "u": "יפה מאוד! מה זה שם?"
          },
          "perComprovar": false,
          "qui": "מורה"
        },
        {
          "id": "pag-50-b0-l9",
          "text": {
            "u": "רוברטו ועמנואל, שקט בבקשה! מדוע אתם מדברים?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-50-b0-l10",
          "text": {
            "u": "אנחנו לא מדברים."
          },
          "perComprovar": false,
          "qui": "עמנואל"
        },
        {
          "id": "pag-50-b0-l11",
          "text": {
            "u": "מצוין. אנחנו מתחילים. אני כותבת שאלות על הלוח"
          },
          "perComprovar": false,
          "qui": "מורה"
        },
        {
          "id": "pag-50-b0-l12",
          "text": {
            "u": "ואתם עונים. אתם כותבים תשובות במחברות."
          },
          "perComprovar": false
        },
        {
          "id": "pag-50-b0-l13",
          "text": {
            "u": "סליחה, המורה, אני לא מבין."
          },
          "perComprovar": false,
          "qui": "עמנואל"
        },
        {
          "id": "pag-50-b0-l14",
          "text": {
            "u": "בבקשה להגיד עוד פעם."
          },
          "perComprovar": false
        },
        {
          "id": "pag-50-b0-l15",
          "text": {
            "u": "סטיב, אתה מבין מה שאני אומרת?"
          },
          "perComprovar": false,
          "qui": "מורה"
        },
        {
          "id": "pag-50-b0-l16",
          "text": {
            "u": "כן, אני מבין הכול."
          },
          "perComprovar": false,
          "qui": "סטיב"
        },
        {
          "id": "pag-50-b0-l17",
          "text": {
            "u": "עמנואל, סטיב מבין הכול. הוא לא מדבר עם חבר..."
          },
          "perComprovar": false,
          "qui": "מורה"
        },
        {
          "id": "pag-50-b0-l18",
          "text": {
            "u": "עמנואל! אתה לא יכול לשבת בשקט?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-50-b0-l19",
          "text": {
            "u": "הנה דוריס."
          },
          "perComprovar": false,
          "qui": "סטיב"
        }
      ]
    },
    {
      "id": "pag-51-b0",
      "pagina": "pag-51",
      "titol": {
        "u": "שיעור בכיתה של רוברטו (המשך)",
        "perComprovar": false,
        "ca": "Classe a l'aula d'en Roberto (continuació)"
      },
      "tipus": "dialeg",
      "personatges": [
        "מורה",
        "דוריס",
        "עמנואל"
      ],
      "linies": [
        {
          "id": "pag-51-b0-l0",
          "text": {
            "u": "בוקר טוב, דוריס. עכשיו את באה?"
          },
          "perComprovar": false,
          "qui": "מורה"
        },
        {
          "id": "pag-51-b0-l1",
          "text": {
            "u": "סליחה.... האוטובוס...."
          },
          "perComprovar": false,
          "qui": "דוריס"
        },
        {
          "id": "pag-51-b0-l2",
          "text": {
            "u": "בבקשה להיכנס. יש מקום על-יד רוברטו."
          },
          "perComprovar": false,
          "qui": "מורה"
        },
        {
          "id": "pag-51-b0-l3",
          "text": {
            "u": "(דוריס נכנסת ויושבת)."
          },
          "perComprovar": false
        },
        {
          "id": "pag-51-b0-l4",
          "text": {
            "u": "חברים, אנחנו ממשיכים. על הלוח יש שאלות."
          },
          "perComprovar": false
        },
        {
          "id": "pag-51-b0-l5",
          "text": {
            "u": "אתם צריכים לכתוב תשובות במחברות."
          },
          "perComprovar": false
        },
        {
          "id": "pag-51-b0-l6",
          "text": {
            "u": "יש שאלות?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-51-b0-l7",
          "text": {
            "u": "כן, אני רוצה לשאול שאלה."
          },
          "perComprovar": false,
          "qui": "עמנואל"
        },
        {
          "id": "pag-51-b0-l8",
          "text": {
            "u": "יפה מאוד. בבקשה לשאול."
          },
          "perComprovar": false,
          "qui": "מורה"
        },
        {
          "id": "pag-51-b0-l9",
          "text": {
            "u": "אני רוצה לשאול מתי יש הפסקה?"
          },
          "perComprovar": false,
          "qui": "עמנואל"
        }
      ]
    },
    {
      "id": "pag-51-b1",
      "pagina": "pag-51",
      "titol": {
        "u": "שיעור בכיתה של רוברטו (המשך)",
