          "perComprovar": false,
          "audio": {
            "normal": "687c78d8a00b.m4a",
            "lent": "687c78d8a00b.m4a"
          }
        },
        {
          "id": "pag-54-b2-l3",
          "text": {
            "u": "הוא שואל את אמא אם אבא בבית."
