        "ca": "Classe a l'aula d'en Roberto (continuació)"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-51-b1-l0",
          "text": {
            "u": "פתגם: אֵיזֶהוּ חָכָם? הַיּוֹדֵעַ לִשְׁאוֹל ____"
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-51-b2",
      "pagina": "pag-51",
      "titol": {
        "u": "מַדּוּעַ? כִּי",
        "perComprovar": false,
        "ca": "Classe a l'aula d'en Roberto (continuació)"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-51-b2-l0",
          "text": {
            "u": "מדוע רוברטו לא יודע עברית?"
          },
          "perComprovar": false,
          "audio": {
            "normal": "03a4ff493af6.m4a",
            "lent": "00f493420cf6.m4a"
          }
        },
        {
          "id": "pag-51-b2-l1",
          "text": {
            "u": "- כי הוא עולה חדש."
          },
          "perComprovar": false,
          "audio": {
            "normal": "776667d8d71d.m4a",
            "lent": "a717d1811ca7.m4a"
          }
        },
        {
          "id": "pag-51-b2-l2",
          "text": {
            "u": "למה הוא בא לאולפן?"
          },
          "perComprovar": false,
          "audio": {
            "normal": "dd86a21da3ff.m4a",
            "lent": "ec7a3822fef7.m4a"
          }
        },
        {
          "id": "pag-51-b2-l3",
          "text": {
            "u": "- כי הוא רוצה ללמוד עברית."
          },
          "perComprovar": false,
          "audio": {
            "normal": "5917b7c00e62.m4a",
            "lent": "fb59d0b5a398.m4a"
          }
        },
        {
          "id": "pag-51-b2-l4",
          "text": {
            "u": "מדוע הוא לא בא היום לכיתה?"
          },
          "perComprovar": false,
          "audio": {
            "normal": "4afc800a98d5.m4a",
            "lent": "617ed11fba9e.m4a"
          }
        },
        {
          "id": "pag-51-b2-l5",
          "text": {
            "u": "- מפני שהוא חולה."
          },
          "perComprovar": false,
          "audio": {
            "normal": "4f9f5be9c086.m4a",
            "lent": "02cdb9b276e7.m4a"
          }
        }
      ]
    },
    {
      "id": "pag-52-b0",
      "pagina": "pag-52",
