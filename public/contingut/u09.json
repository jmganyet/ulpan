          "perComprovar": false
        },
        {
          "id": "pag-54-b4-l5",
          "text": {
            "u": "רוצה לשאול · יצחק חולה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-54-b4-l6",
          "text": {
            "u": "יש היום שיעור."
