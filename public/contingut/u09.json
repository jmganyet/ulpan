      ]
    },
    {
      "id": "pag-51-b2",
      "pagina": "pag-51",
      "titol": {
        "u": "מַדּוּעַ? כִּי",
        "perComprovar": false,
        "ca": "Classe a l'aula d'en Roberto (continuació)"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-51-b2-l0",
          "text": {
            "u": "מדוע רוברטו לא יודע עברית?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-51-b2-l1",
          "text": {
            "u": "- כי הוא עולה חדש."
          },
          "perComprovar": false
        },
        {
          "id": "pag-51-b2-l2",
          "text": {
            "u": "למה הוא בא לאולפן?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-51-b2-l3",
          "text": {
            "u": "- כי הוא רוצה ללמוד עברית."
          },
          "perComprovar": false
        },
        {
          "id": "pag-51-b2-l4",
          "text": {
            "u": "מדוע הוא לא בא היום לכיתה?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-51-b2-l5",
          "text": {
            "u": "- מפני שהוא חולה."
          },
          "perComprovar": false
        }
      ]
    },
