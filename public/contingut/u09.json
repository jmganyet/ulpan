  "gramatica": [],
  "textos": [
    {
      "id": "pag-50-b0",
      "pagina": "pag-50",
      "titol": {
        "u": "שִׁעור בַּכִּתָּה שֶׁל רובֶּרטו",
        "perComprovar": false,
        "ca": "Classe a l'aula d'en Roberto"
      },
      "tipus": "dialeg",
      "personatges": [
        "מורה",
        "תלמידים",
        "יוסף",
        "עמנואל",
        "סטיב"
      ],
      "linies": [
        {
          "id": "pag-50-b0-l0",
          "text": {
            "u": "בוקר טוב, תלמידים!"
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "25961bd698d9.m4a",
            "lent": "25961bd698d9.m4a"
          }
        },
        {
          "id": "pag-50-b0-l1",
          "text": {
            "u": "בוקר טוב!"
          },
          "perComprovar": false,
          "qui": "תלמידים",
          "audio": {
            "normal": "2ddfbb441342.m4a",
            "lent": "2ddfbb441342.m4a"
          }
        },
        {
          "id": "pag-50-b0-l2",
          "text": {
            "u": "מדוע שושנה לא באה היום?"
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "48da67089084.m4a",
            "lent": "48da67089084.m4a"
          }
        },
        {
          "id": "pag-50-b0-l3",
          "text": {
            "u": "כי היא חולה."
          },
          "perComprovar": false,
          "qui": "תלמידים",
          "audio": {
            "normal": "ffa57b0ce4e8.m4a",
            "lent": "ffa57b0ce4e8.m4a"
          }
        },
        {
          "id": "pag-50-b0-l4",
          "text": {
            "u": "ואיפה דוריס?"
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "ea5f0d3064b4.m4a",
            "lent": "ea5f0d3064b4.m4a"
          }
        },
        {
          "id": "pag-50-b0-l5",
          "text": {
            "u": "אנחנו לא יודעים."
          },
          "perComprovar": false,
          "qui": "תלמידים",
          "audio": {
            "normal": "d01baf76bb8e.m4a",
            "lent": "d01baf76bb8e.m4a"
          }
        },
        {
          "id": "pag-50-b0-l6",
          "text": {
            "u": "גם יוסף חסר."
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "1fee59ad44a6.m4a",
            "lent": "1fee59ad44a6.m4a"
          }
        },
        {
          "id": "pag-50-b0-l7",
          "text": {
            "u": "לא, אני פה!"
          },
          "perComprovar": false,
          "qui": "יוסף",
          "audio": {
            "normal": "d67285d5be5e.m4a",
            "lent": "d67285d5be5e.m4a"
          }
        },
        {
          "id": "pag-50-b0-l8",
          "text": {
            "u": "יפה מאוד! מה זה שם?"
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "36d5f97fdcf3.m4a",
            "lent": "36d5f97fdcf3.m4a"
          }
        },
        {
          "id": "pag-50-b0-l9",
          "text": {
            "u": "רוברטו ועמנואל, שקט בבקשה! מדוע אתם מדברים?"
          },
          "perComprovar": false,
          "audio": {
            "normal": "845863a89ca7.m4a",
            "lent": "845863a89ca7.m4a"
          }
        },
        {
          "id": "pag-50-b0-l10",
          "text": {
            "u": "אנחנו לא מדברים."
          },
          "perComprovar": false,
          "qui": "עמנואל",
          "audio": {
            "normal": "e97c23bad8b9.m4a",
            "lent": "e97c23bad8b9.m4a"
          }
        },
        {
          "id": "pag-50-b0-l11",
          "text": {
            "u": "מצוין. אנחנו מתחילים. אני כותבת שאלות על הלוח"
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "3ed02d4d6c31.m4a",
            "lent": "3ed02d4d6c31.m4a"
          }
        },
        {
          "id": "pag-50-b0-l12",
          "text": {
            "u": "ואתם עונים. אתם כותבים תשובות במחברות."
          },
          "perComprovar": false,
          "audio": {
            "normal": "a4f6c5abec5c.m4a",
            "lent": "a4f6c5abec5c.m4a"
          }
        },
        {
          "id": "pag-50-b0-l13",
          "text": {
            "u": "סליחה, המורה, אני לא מבין."
          },
          "perComprovar": false,
          "qui": "עמנואל",
          "audio": {
            "normal": "cf76f506aa2c.m4a",
            "lent": "cf76f506aa2c.m4a"
          }
        },
        {
          "id": "pag-50-b0-l14",
          "text": {
            "u": "בבקשה להגיד עוד פעם."
          },
          "perComprovar": false,
          "audio": {
            "normal": "c53c96438fc9.m4a",
            "lent": "c53c96438fc9.m4a"
          }
        },
        {
          "id": "pag-50-b0-l15",
          "text": {
            "u": "סטיב, אתה מבין מה שאני אומרת?"
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "cafcb0af1e0a.m4a",
            "lent": "cafcb0af1e0a.m4a"
          }
        },
        {
          "id": "pag-50-b0-l16",
          "text": {
            "u": "כן, אני מבין הכול."
          },
          "perComprovar": false,
          "qui": "סטיב",
          "audio": {
            "normal": "1a3b63798080.m4a",
            "lent": "1a3b63798080.m4a"
          }
        },
        {
          "id": "pag-50-b0-l17",
          "text": {
            "u": "עמנואל, סטיב מבין הכול. הוא לא מדבר עם חבר..."
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "7441979e1d83.m4a",
            "lent": "7441979e1d83.m4a"
          }
        },
        {
          "id": "pag-50-b0-l18",
          "text": {
            "u": "עמנואל! אתה לא יכול לשבת בשקט?"
          },
          "perComprovar": false,
          "audio": {
            "normal": "110bc949c4f6.m4a",
            "lent": "110bc949c4f6.m4a"
          }
        },
        {
          "id": "pag-50-b0-l19",
          "text": {
            "u": "הנה דוריס."
          },
          "perComprovar": false,
          "qui": "סטיב",
          "audio": {
            "normal": "ace0ac26626a.m4a",
            "lent": "ace0ac26626a.m4a"
          }
        }
      ]
    },
    {
      "id": "pag-51-b0",
      "pagina": "pag-51",
      "titol": {
        "u": "שיעור בכיתה של רוברטו (המשך)",
        "perComprovar": false,
        "ca": "Classe a l'aula d'en Roberto (continuació)"
      },
      "tipus": "dialeg",
      "personatges": [
        "מורה",
        "דוריס",
        "עמנואל"
      ],
      "linies": [
        {
          "id": "pag-51-b0-l0",
          "text": {
            "u": "בוקר טוב, דוריס. עכשיו את באה?"
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "101d0198873e.m4a",
            "lent": "101d0198873e.m4a"
          }
        },
        {
          "id": "pag-51-b0-l1",
          "text": {
            "u": "סליחה.... האוטובוס...."
          },
          "perComprovar": false,
          "qui": "דוריס",
          "audio": {
            "normal": "77a92a83c478.m4a",
            "lent": "77a92a83c478.m4a"
          }
        },
        {
          "id": "pag-51-b0-l2",
          "text": {
            "u": "בבקשה להיכנס. יש מקום על-יד רוברטו."
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "e40647bd83c2.m4a",
            "lent": "e40647bd83c2.m4a"
          }
        },
        {
          "id": "pag-51-b0-l3",
          "text": {
            "u": "(דוריס נכנסת ויושבת)."
          },
          "perComprovar": false,
          "audio": {
            "normal": "2fa9c2176c15.m4a",
            "lent": "2fa9c2176c15.m4a"
          }
        },
        {
          "id": "pag-51-b0-l4",
          "text": {
            "u": "חברים, אנחנו ממשיכים. על הלוח יש שאלות."
          },
          "perComprovar": false,
          "audio": {
            "normal": "eab87a37e828.m4a",
            "lent": "eab87a37e828.m4a"
          }
        },
        {
          "id": "pag-51-b0-l5",
          "text": {
            "u": "אתם צריכים לכתוב תשובות במחברות."
          },
          "perComprovar": false,
          "audio": {
            "normal": "2f6ebcaf3971.m4a",
            "lent": "2f6ebcaf3971.m4a"
          }
        },
        {
          "id": "pag-51-b0-l6",
          "text": {
            "u": "יש שאלות?"
          },
          "perComprovar": false,
          "audio": {
            "normal": "acd4644d107c.m4a",
            "lent": "acd4644d107c.m4a"
          }
        },
        {
          "id": "pag-51-b0-l7",
          "text": {
            "u": "כן, אני רוצה לשאול שאלה."
          },
          "perComprovar": false,
          "qui": "עמנואל",
          "audio": {
            "normal": "47a7eb5ffca0.m4a",
            "lent": "47a7eb5ffca0.m4a"
          }
        },
        {
          "id": "pag-51-b0-l8",
          "text": {
            "u": "יפה מאוד. בבקשה לשאול."
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "62e54f2dc803.m4a",
            "lent": "62e54f2dc803.m4a"
          }
        },
        {
          "id": "pag-51-b0-l9",
          "text": {
            "u": "אני רוצה לשאול מתי יש הפסקה?"
          },
          "perComprovar": false,
          "qui": "עמנואל",
          "audio": {
            "normal": "f7c5a4355c13.m4a",
            "lent": "f7c5a4355c13.m4a"
          }
        }
      ]
    },
    {
      "id": "pag-51-b1",
      "pagina": "pag-51",
      "titol": {
        "u": "שיעור בכיתה של רוברטו (המשך)",
        "perComprovar": false,
        "ca": "Classe a l'aula d'en Roberto (continuació)"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-51-b1-l0",
          "text": {
            "u": "פתגם: אֵיזֶהוּ חָכָם? הַיּוֹדֵעַ לִשְׁאוֹל ____"
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-51-b2",
      "pagina": "pag-51",
      "titol": {
        "u": "מַדּוּעַ? כִּי",
        "perComprovar": false,
        "ca": "Classe a l'aula d'en Roberto (continuació)"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-51-b2-l0",
          "text": {
            "u": "מדוע רוברטו לא יודע עברית?"
          },
          "perComprovar": false,
          "audio": {
            "normal": "fd6ad857fc2c.m4a",
            "lent": "fd6ad857fc2c.m4a"
          }
        },
        {
          "id": "pag-51-b2-l1",
          "text": {
            "u": "- כי הוא עולה חדש."
          },
          "perComprovar": false,
          "audio": {
            "normal": "123a8c9aa7c0.m4a",
            "lent": "123a8c9aa7c0.m4a"
          }
        },
        {
          "id": "pag-51-b2-l2",
          "text": {
            "u": "למה הוא בא לאולפן?"
          },
          "perComprovar": false,
          "audio": {
            "normal": "7bd2e6e31b51.m4a",
            "lent": "7bd2e6e31b51.m4a"
          }
        },
        {
          "id": "pag-51-b2-l3",
          "text": {
            "u": "- כי הוא רוצה ללמוד עברית."
          },
          "perComprovar": false,
          "audio": {
            "normal": "70eef67a507f.m4a",
            "lent": "70eef67a507f.m4a"
          }
        },
        {
          "id": "pag-51-b2-l4",
          "text": {
            "u": "מדוע הוא לא בא היום לכיתה?"
          },
          "perComprovar": false,
          "audio": {
            "normal": "6678fa44d60c.m4a",
            "lent": "6678fa44d60c.m4a"
          }
        },
        {
          "id": "pag-51-b2-l5",
          "text": {
            "u": "- מפני שהוא חולה."
          },
          "perComprovar": false,
          "audio": {
            "normal": "b477a66dac76.m4a",
            "lent": "b477a66dac76.m4a"
          }
        }
      ]
    },
    {
      "id": "pag-52-b0",
      "pagina": "pag-52",
