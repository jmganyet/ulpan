            "u": "7. הארונות לבנים."
          },
          "perComprovar": false,
          "audio": {
            "normal": "583d886eb208.m4a",
            "lent": "f972b48f9bdb.m4a"
          }
        },
        {
          "id": "pag-40-b5-l7",
          "text": {
            "u": "8. העטים שחורים."
          },
          "perComprovar": false,
