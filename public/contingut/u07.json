          },
          "perComprovar": false,
          "audio": {
            "normal": "16e9cac42489.m4a",
            "lent": "16e9cac42489.m4a"
          }
        },
        {
          "id": "pag-40-b5-l7",
          "text": {
            "u": "8. העטים שחורים."
          },
          "perComprovar": false,
          "audio": {
            "normal": "f05eb6c2e63f.m4a",
            "lent": "f05eb6c2e63f.m4a"
          }
        },
        {
          "id": "pag-40-b5-l8",
          "text": {
            "u": "9. אלה שמות עבריים."
          },
          "perComprovar": false,
          "audio": {
            "normal": "8319cc9ae8ec.m4a",
            "lent": "8319cc9ae8ec.m4a"
          }
        },
        {
          "id": "pag-40-b5-l9",
          "text": {
            "u": "10. הם בעלים טובים."
          },
          "perComprovar": false,
