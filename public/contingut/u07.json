          "perComprovar": false,
          "audio": {
            "normal": "a42460f150d8.m4a",
            "lent": "fdc4f37459e0.m4a"
          }
        },
        {
          "id": "pag-42-b0-l2",
          "text": {
            "u": "קשה ללמוד עברית. עברית שפה קשה."
          },
          "perComprovar": false,
          "audio": {
            "normal": "92ca9fc6bbb9.m4a",
            "lent": "104e29121361.m4a"
          }
        }
      ]
    },
