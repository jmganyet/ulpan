    {
      "id": "pag-41-b0",
      "pagina": "pag-41",
      "titol": {
        "u": "אַתָּה יוֹדֵעַ עִבְרִית?",
        "perComprovar": false,
        "ca": "Saps hebreu?"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-41-b0-l0",
          "text": {
            "u": "יצחק אתה יודע עברית?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-41-b0-l1",
          "text": {
            "u": "– עוד לא, אני לומד עברית."
          },
          "perComprovar": false
        },
        {
          "id": "pag-41-b0-l2",
          "text": {
            "u": "אתה יודע אִידִיש?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-41-b0-l3",
          "text": {
            "u": "– כן, אני יודע. אני מדבר, קורא וכותב אִידִיש."
          },
          "perComprovar": false
        },
        {
          "id": "pag-41-b0-l4",
          "text": {
            "u": "אני יודע גם פורטוגֶזִית."
          },
          "perComprovar": true
        },
        {
          "id": "pag-41-b0-l5",
          "text": {
            "u": "שרה, את יודעת אִידִיש?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-41-b0-l6",
          "text": {
            "u": "– לא, אני מבינה מעט אידיש."
          },
          "perComprovar": false
        },
        {
          "id": "pag-41-b0-l7",
          "text": {
            "u": "איזוֹ שפה את יודעת?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-41-b0-l8",
          "text": {
            "u": "– אני יודעת רק פורטוגזית. אני קוראת, כותבת ומדברת פורטוגזית."
          },
          "perComprovar": false
        },
        {
          "id": "pag-41-b0-l9",
          "text": {
            "u": "בוריס ופרידה, אתם יודעים עברית?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-41-b0-l10",
          "text": {
            "u": "– לא, אנחנו יודעים רוסית. אנחנו לומדים עברית."
          },
          "perComprovar": false
        },
        {
          "id": "pag-41-b0-l11",
          "text": {
            "u": "פה בכיתה אנחנו מדברים, קוראים וכותבים עברית."
          },
          "perComprovar": false
        },
        {
          "id": "pag-41-b0-l12",
          "text": {
            "u": "עכשיו אנחנו מבינים מעט עברית."
          },
          "perComprovar": false
        },
        {
          "id": "pag-41-b0-l13",
          "text": {
            "u": "חנה ורותי יודעות עברית?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-41-b0-l14",
          "text": {
            "u": "– איזו שאלה! הן מישראל. רותי יודעת רק עברית וחנה יודעת פורטוגזית ועברית."
          },
          "perComprovar": false
        },
        {
          "id": "pag-41-b0-l15",
          "text": {
            "u": "איזה שפות אתה יודע סטיב?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-41-b0-l16",
          "text": {
            "u": "– אני יודע אַנגלית, גֶרמָנִית, צָרפַתִית ומבין מעט עברית."
          },
          "perComprovar": false
        },
        {
          "id": "pag-41-b0-l17",
          "text": {
            "u": "סטיב יודע הרבה שפות!"
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-42-b0",
      "pagina": "pag-42",
      "titol": {
        "u": "Continuació del diàleg",
        "perComprovar": false,
        "ca": "Els verbs nous"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-42-b0-l0",
          "text": {
            "u": "ואת דוריס, איזה שפות את יודעת?"
          },
          "perComprovar": false
        },
        {
          "id": "pag-42-b0-l1",
          "text": {
            "u": "– אני יודעת רק אנגלית. אני רוצה ללמוד עברית."
          },
          "perComprovar": false
        },
        {
          "id": "pag-42-b0-l2",
          "text": {
            "u": "קשה ללמוד עברית. עברית שפה קשה."
          },
          "perComprovar": false
        }
      ]
    },
