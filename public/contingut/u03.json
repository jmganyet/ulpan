  "textos": [
    {
      "id": "pag-15-b0",
      "pagina": "pag-15",
      "titol": {
        "u": "איפה?",
        "perComprovar": false,
        "ca": "Ara la família Leví és a Israel"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-15-b0-l0",
          "text": {
            "u": "יצחק, מאין אתה ושרה? — אנחנו מברזיל."
          },
          "perComprovar": false
        },
        {
          "id": "pag-15-b0-l1",
          "text": {
            "u": "איפה אתם עכשיו? — עכשיו אנחנו בְּישראל."
          },
          "perComprovar": false
        },
        {
          "id": "pag-15-b0-l2",
          "text": {
            "u": "בְּמרכז-קליטה בְּקרית-שמונָה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-15-b0-l3",
          "text": {
            "u": "איפה קרית-שמונה? — קרית-שמונה בַּגָּליל."
          },
          "perComprovar": false
        },
        {
          "id": "pag-15-b0-l4",
          "text": {
            "u": "ואיפה רוברטו? — רוברטו בַּאולפן בְּקיבוץ דָּן."
          },
          "perComprovar": false
        },
        {
          "id": "pag-15-b0-l5",
          "text": {
            "u": "גם קיבוץ דן בַּגליל? — כן, גם קיבוץ דן בַּגליל."
          },
          "perComprovar": false
        },
        {
          "id": "pag-15-b0-l6",
          "text": {
            "u": "גם אסתר בְּקיבוץ? — לא, אסתר בְּחיפָה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-15-b0-l7",
          "text": {
            "u": "היא סטודנטית בָּאוניברסיטה"
          },
          "perComprovar": false
        },
        {
          "id": "pag-15-b0-l8",
          "text": {
            "u": "בְּחיפה."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-15-b1",
      "pagina": "pag-15",
      "titol": {
        "u": "איפה?",
        "perComprovar": false,
        "ca": "Ara la família Leví és a Israel"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-15-b1-l0",
          "text": {
            "u": "עכשיו משפחת לוי בארץ."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-16-b0",
      "pagina": "pag-16",
      "titol": {
        "u": "תרגיל 5",
        "perComprovar": false,
        "ca": "Exercicis 5 i 6"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-16-b0-l0",
          "text": {
            "u": "כתוב: מי, מה, מאין, איפה"
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-16-b1",
      "pagina": "pag-16",
      "titol": {
        "u": "תרגיל 5",
        "perComprovar": false,
        "ca": "Exercicis 5 i 6"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-16-b1-l0",
          "text": {
            "u": "1. ____ אתה? — אני סטיב."
          },
          "perComprovar": false
        },
        {
          "id": "pag-16-b1-l1",
          "text": {
            "u": "2. ____ אתה? — אני מאנגליה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-16-b1-l2",
          "text": {
            "u": "3. ____ אתה עכשיו? — בישראל."
          },
          "perComprovar": false
        },
        {
          "id": "pag-16-b1-l3",
          "text": {
            "u": "4. ____ אילת? — בישראל."
          },
          "perComprovar": false
        },
        {
          "id": "pag-16-b1-l4",
          "text": {
            "u": "5. ____ יוהנסבורג? — בְּדרום-אפריקה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-16-b1-l5",
          "text": {
            "u": "6. ____ סם? — מִדרום-אפריקה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-16-b1-l6",
          "text": {
            "u": "7. ____ מברזיל? — רוברטו מִברזיל."
          },
          "perComprovar": false
        },
        {
          "id": "pag-16-b1-l7",
          "text": {
            "u": "8. ____ עמנואל? — עמנואל מִברזיל."
          },
          "perComprovar": false
        },
        {
          "id": "pag-16-b1-l8",
          "text": {
            "u": "9. ____ זה? — זה ספר."
          },
          "perComprovar": false
        },
        {
          "id": "pag-16-b1-l9",
          "text": {
            "u": "10. ____ המוֹרָה של יצחק? — צפורה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-16-b1-l10",
          "text": {
            "u": "11. ____ המורה של יצחק? — מישראל."
          },
          "perComprovar": false
        },
        {
          "id": "pag-16-b1-l11",
          "text": {
            "u": "12. ____ המורה? — באולפן."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-16-b2",
      "pagina": "pag-16",
      "titol": {
        "u": "תרגיל 6",
        "perComprovar": false,
        "ca": "Exercicis 5 i 6"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-16-b2-l0",
          "text": {
            "u": "כתוב ו... בּ... מ... ה..."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-16-b3",
      "pagina": "pag-16",
      "titol": {
        "u": "תרגיל 6",
        "perComprovar": false,
        "ca": "Exercicis 5 i 6"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-16-b3-l0",
          "text": {
            "u": "1. רוברטו ____אסתר אח ____אחות. הם עולים חדשים ____ברזיל."
          },
          "perComprovar": false
        },
        {
          "id": "pag-16-b3-l1",
          "text": {
            "u": "2. ירושלים לא ____אנגליה. ירושלים ____ישראל."
          },
          "perComprovar": false
        },
        {
          "id": "pag-16-b3-l2",
          "text": {
            "u": "3. זה לא ____ארגנטינה, זה מרוסיה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-16-b3-l3",
          "text": {
            "u": "4. ____הורים של רוברטו תלמידים ____אולפן ____קרית-שמונה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-16-b3-l4",
          "text": {
            "u": "5. סטיב ____דוריס תיירים ____אנגליה. עכשיו הם ____ישראל."
          },
          "perComprovar": false
        },
        {
          "id": "pag-16-b3-l5",
          "text": {
            "u": "6. ____ילדים של צפורה גדולים ____יפים."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-17-b0",
      "pagina": "pag-17",
      "titol": {
        "u": "איפה אתה גר?",
        "perComprovar": false,
        "ca": "On vius?"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-17-b0-l0",
          "text": {
            "u": "יצחק, איפה אתה גר? — אני גר בקרית-שמונה,"
          },
          "perComprovar": false
        },
        {
          "id": "pag-17-b0-l1",
          "text": {
            "u": "במרכז-קליטה בְּרחוב תֵּל-חַי."
          },
          "perComprovar": false
        },
        {
          "id": "pag-17-b0-l2",
          "text": {
            "u": "ואיפה אתה לומד? — אני לומד באולפן במרכז-קליטה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-17-b0-l3",
          "text": {
            "u": "גם שרה לומדת שם? — כן גם היא לומדת שם."
          },
          "perComprovar": false
        },
        {
          "id": "pag-17-b0-l4",
          "text": {
            "u": "מה אתם לומדים? — אנחנו לומדים עברית."
          },
          "perComprovar": false
        },
        {
          "id": "pag-17-b0-l5",
          "text": {
            "u": "ואיפה לומד רוברטו? — הוא לומד באולפן-עבודה"
          },
          "perComprovar": false
        },
        {
          "id": "pag-17-b0-l6",
          "text": {
            "u": "בקיבוץ דן. הוא עובד ולומד."
          },
          "perComprovar": false
        },
        {
          "id": "pag-17-b0-l7",
          "text": {
            "u": "התלמידים באולפן-עבודה"
          },
          "perComprovar": false
        },
        {
          "id": "pag-17-b0-l8",
          "text": {
            "u": "עובדים ולומדים."
          },
          "perComprovar": false
        },
        {
          "id": "pag-17-b0-l9",
          "text": {
            "u": "גם אסתר גרה בקיבוץ? — לא, היא גרה בחיפה"
          },
          "perComprovar": false
        },
        {
          "id": "pag-17-b0-l10",
          "text": {
            "u": "עם חברה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-17-b0-l11",
          "text": {
            "u": "אסתר עובדת? — לא, היא לא עובדת, היא לומדת."
          },
          "perComprovar": false
        },
        {
          "id": "pag-17-b0-l12",
          "text": {
            "u": "היא סטודנטית."
          },
          "perComprovar": false
        },
        {
          "id": "pag-17-b0-l13",
          "text": {
            "u": "מי החברה של אסתר? — תמר כֹּהֵן. גם היא"
          },
          "perComprovar": false
        },
        {
          "id": "pag-17-b0-l14",
          "text": {
            "u": "עולה חדשה מברזיל."
          },
          "perComprovar": false
        },
        {
          "id": "pag-17-b0-l15",
          "text": {
            "u": "גם היא סטודנטית."
          },
          "perComprovar": false
        },
        {
          "id": "pag-17-b0-l16",
          "text": {
            "u": "איפה הן גרות? — הן גרות ברחוב הָאוֹרֶן מספר 7 (שֶׁבַע)."
          },
          "perComprovar": false
        },
        {
          "id": "pag-17-b0-l17",
          "text": {
            "u": "תמר ואסתר לומדות באוניברסיטה"
          },
          "perComprovar": false
        },
        {
          "id": "pag-17-b0-l18",
          "text": {
            "u": "בחיפה. הן לא עובדות."
          },
          "perComprovar": false
        },
        {
          "id": "pag-17-b0-l19",
          "text": {
            "u": "אסתר לומדת פסיכולוגיה"
          },
          "perComprovar": false
        },
        {
          "id": "pag-17-b0-l20",
          "text": {
            "u": "ותמר לומדת סוציולוגיה."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-18-b0",
      "pagina": "pag-18",
      "titol": {
        "u": "מה עושה?",
        "perComprovar": false,
        "ca": "Què fa en Roberto?"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-18-b0-l0",
          "text": {
            "u": "מה עושֶׂה רוברטו? — רוברטו עובד ולומד בקיבוץ."
          },
          "perComprovar": false
        },
        {
          "id": "pag-18-b0-l1",
          "text": {
            "u": "מה עושָׂה אסתר? — אסתר לומדת פסיכולוגיה"
          },
          "perComprovar": false
        },
        {
          "id": "pag-18-b0-l2",
          "text": {
            "u": "באוניברסיטה בחיפה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-18-b0-l3",
          "text": {
            "u": "מה עושִׂים שרה ויצחק? — הם לומדים עברית"
          },
          "perComprovar": false
        },
        {
          "id": "pag-18-b0-l4",
          "text": {
            "u": "באולפן בקרית-שמונה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-18-b0-l5",
          "text": {
            "u": "מה עושות אסתר ותמר? — הן לומדות"
          },
          "perComprovar": false
        },
        {
          "id": "pag-18-b0-l6",
          "text": {
            "u": "באוניברסיטה בחיפה."
          },
          "perComprovar": false
        }
      ]
