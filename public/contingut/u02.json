          "id": "pag-12-b2-l5",
          "text": {
            "u": "היא אמא של אסתר."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-12-b3",
      "pagina": "pag-12",
      "titol": {
        "u": "מי אלה?",
        "perComprovar": false,
        "ca": "La família Leví"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-12-b3-l0",
          "text": {
            "u": "אלה שרה ויצחק. אלה גברת ואדון לוי."
          },
          "perComprovar": false
        },
        {
          "id": "pag-12-b3-l1",
          "text": {
            "u": "יצחק ושרה בעל ואישה."
          },
          "perComprovar": false
        },
        {
          "id": "pag-12-b3-l2",
          "text": {
            "u": "הם אמא ואבא של רוברטו ושל אסתר."
          },
          "perComprovar": false
        },
        {
          "id": "pag-12-b3-l3",
          "text": {
            "u": "הם ההורים של רוברטו ושל אסתר."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-13-b0",
      "pagina": "pag-13",
      "titol": {
        "u": "מי הם?",
        "perComprovar": false,
        "ca": "Qui són?"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-13-b0-l0",
          "text": {
            "u": "הם רוברטו ואסתר. אלה הילדים של שרה ויצחק."
          },
          "perComprovar": false
        },
        {
          "id": "pag-13-b0-l1",
          "text": {
            "u": "אסתר - בת. היא הבת של שרה ויצחק."
          },
          "perComprovar": false
        },
        {
          "id": "pag-13-b0-l2",
          "text": {
            "u": "רוברטו - בן. הוא הבן של שרה ויצחק."
          },
          "perComprovar": false
        },
        {
          "id": "pag-13-b0-l3",
          "text": {
            "u": "אסתר - אחות. היא הָאחות של רוברטו."
          },
          "perComprovar": true
        },
        {
          "id": "pag-13-b0-l4",
          "text": {
            "u": "רוברטו - אח. הוא האח של אסתר."
          },
          "perComprovar": false
        }
      ]
    },
    {
      "id": "pag-13-b1",
      "pagina": "pag-13",
      "titol": {
