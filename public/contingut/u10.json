          "perComprovar": false,
          "audio": {
            "normal": "1532036a4df7.m4a",
            "lent": "1532036a4df7.m4a"
          }
        },
        {
          "id": "pag-55-b2-l1",
          "text": {
            "u": "לפועל \"להיות\" בעברית יש רק עבר ועתיד."
          },
          "perComprovar": false,
          "audio": {
            "normal": "c1f3f719830d.m4a",
            "lent": "c1f3f719830d.m4a"
          }
        }
      ]
    },
