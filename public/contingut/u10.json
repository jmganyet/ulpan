    {
      "id": "pag-56-b0",
      "pagina": "pag-56",
      "titol": {
        "u": "להיות ב... / להיות אצל...",
        "perComprovar": false,
        "ca": "Ser a... / estar a casa de..."
      },
      "tipus": "dialeg",
      "personatges": [
        "מורה",
        "יצחק"
      ],
      "linies": [
        {
          "id": "pag-56-b0-l0",
          "text": {
            "u": "יצחק איפה הָיִיתָ אתמול?"
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "f488334b76ae.m4a",
            "lent": "2680143c43ad.m4a"
          }
        },
        {
          "id": "pag-56-b0-l1",
          "text": {
            "u": "הָיִיתִי בקופת-חולים."
          },
          "perComprovar": false,
          "qui": "יצחק",
          "audio": {
            "normal": "8b805642594b.m4a",
            "lent": "b4431079d58c.m4a"
          }
        },
        {
          "id": "pag-56-b0-l2",
          "text": {
            "u": "ואיפה הָיְתָה שׂרה?"
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "960a1ce5b865.m4a",
            "lent": "0c802e360a8a.m4a"
          }
        },
        {
          "id": "pag-56-b0-l3",
          "text": {
            "u": "היא הָיְתָה בתל-אביב."
          },
          "perComprovar": false,
          "qui": "יצחק",
          "audio": {
            "normal": "0779f6ee3373.m4a",
            "lent": "f363bbeec5a8.m4a"
          }
        },
        {
          "id": "pag-56-b0-l4",
          "text": {
            "u": "ואיפה היא היום?"
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "b9a4e98a8a6d.m4a",
            "lent": "3252ff2538e5.m4a"
          }
        },
        {
          "id": "pag-56-b0-l5",
          "text": {
            "u": "היום היא צריכה לִהיות בחיפה."
          },
          "perComprovar": false,
          "qui": "יצחק",
          "audio": {
            "normal": "e56cd6d6de97.m4a",
            "lent": "acbfd083fd93.m4a"
          }
        },
        {
          "id": "pag-56-b0-l6",
          "text": {
            "u": "יום לומדים ויומיים לא. כך זה לא יכול לִהיות!"
          },
          "perComprovar": false,
          "qui": "מורה",
          "audio": {
            "normal": "ffb1ba4540a9.m4a",
            "lent": "71f2bd1e61b6.m4a"
          }
        },
        {
          "id": "pag-56-b0-l7",
          "text": {
            "u": "כן כבר המלט אמר: \"להיות או לא להיות"
          },
          "perComprovar": false,
          "qui": "יצחק",
          "audio": {
            "normal": "75668cfadde5.m4a",
            "lent": "bc92a0aecc15.m4a"
          }
        },
        {
          "id": "pag-56-b0-l8",
          "text": {
            "u": "זאת השאלה!\""
          },
          "perComprovar": false,
          "audio": {
            "normal": "3323a0caca29.m4a",
            "lent": "199902e5cbcd.m4a"
          }
        }
      ]
    },
    {
