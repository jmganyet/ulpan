          "perComprovar": false,
          "audio": {
            "normal": "7e9ec8103845.m4a",
            "lent": "bc239a0a7d3f.m4a"
          }
        },
        {
          "id": "pag-56-b1-l4",
          "text": {
            "u": "היא היתה בקופת-חולים אצל דוקטור יעקובי."
