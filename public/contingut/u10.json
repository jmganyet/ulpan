    {
      "id": "pag-55-b0",
      "pagina": "pag-55",
      "titol": {
        "u": "לִהְיוֹת — זמן עבר",
        "perComprovar": false,
        "ca": "זמן עבר — Ser/estar: el temps passat"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-55-b0-l0",
          "text": {
            "u": "הַמלט אומר: \"להיות, או לא להיות - זאת השאלה!\""
          },
          "perComprovar": false,
          "audio": {
            "normal": "29c984d6ae29.m4a",
            "lent": "29c984d6ae29.m4a"
          }
        },
        {
          "id": "pag-55-b0-l1",
          "text": {
            "u": "יוסף רוצה להיות בכיתה, אבל הוא צריך להיות במשׂרד."
          },
          "perComprovar": false,
          "audio": {
            "normal": "e64248ec8cc4.m4a",
            "lent": "e64248ec8cc4.m4a"
          }
        },
        {
          "id": "pag-55-b0-l2",
          "text": {
            "u": "התלמידים צריכים להיות בכיתה ב-8."
          },
          "perComprovar": false,
          "audio": {
            "normal": "751933596a0b.m4a",
            "lent": "751933596a0b.m4a"
          }
        }
      ]
    },
    {
      "id": "pag-55-b1",
      "pagina": "pag-55",
      "titol": {
        "u": "לִהְיוֹת — זמן עבר",
