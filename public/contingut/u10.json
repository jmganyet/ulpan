      "tipus": "text",
      "linies": [
        {
          "id": "pag-55-b1-l0",
          "text": {
            "u": "היום משה [requadre ratllat amb una creu] בבית."
          },
          "perComprovar": false,
          "audio": {
            "normal": "c678797e52a5.m4a",
            "lent": "c678797e52a5.m4a"
          }
        },
        {
          "id": "pag-55-b1-l1",
          "text": {
            "u": "אתמול משה הָיָה בבית."
          },
          "perComprovar": false,
          "audio": {
            "normal": "9c2e9cd2b768.m4a",
            "lent": "9c2e9cd2b768.m4a"
          }
        }
      ]
    },
    {
      "id": "pag-55-b2",
      "pagina": "pag-55",
      "titol": {
        "u": "לִהְיוֹת — זמן עבר",
        "perComprovar": false,
        "ca": "זמן עבר — Ser/estar: el temps passat"
