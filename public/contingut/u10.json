      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-56-b1-l0",
          "text": {
            "u": "רחל בִּירושלים אצל חברים."
          },
          "perComprovar": false,
          "audio": {
            "normal": "2f5e889809f8.m4a",
            "lent": "2f5e889809f8.m4a"
          }
        },
        {
          "id": "pag-56-b1-l1",
          "text": {
            "u": "יוסף גר בחיפה אצל חבר."
          },
          "perComprovar": false,
          "audio": {
            "normal": "c708b498caa9.m4a",
            "lent": "c708b498caa9.m4a"
          }
        },
        {
          "id": "pag-56-b1-l2",
          "text": {
            "u": "שׂרה לומדת באולפן אצל המורה רחל."
          },
          "perComprovar": false,
          "audio": {
            "normal": "636990174305.m4a",
            "lent": "636990174305.m4a"
          }
        },
        {
          "id": "pag-56-b1-l3",
          "text": {
            "u": "משה היה במשׂרד אצל גברת כֹּהן."
          },
          "perComprovar": false,
          "audio": {
            "normal": "b1594a0381c0.m4a",
            "lent": "b1594a0381c0.m4a"
          }
        },
        {
          "id": "pag-56-b1-l4",
          "text": {
            "u": "היא היתה בקופת-חולים אצל דוקטור יעקובי."
          },
          "perComprovar": false,
          "audio": {
            "normal": "b52056a42af1.m4a",
            "lent": "b52056a42af1.m4a"
          }
        },
        {
          "id": "pag-56-b1-l5",
          "text": {
            "u": "הספר של יצחק אצל רוברטו."
          },
          "perComprovar": false,
          "audio": {
            "normal": "d8d59db869ab.m4a",
            "lent": "d8d59db869ab.m4a"
          }
        },
        {
          "id": "pag-56-b1-l6",
          "text": {
            "u": "אתמול הן היו אצל חנה."
          },
          "perComprovar": false,
          "audio": {
            "normal": "744368fd8570.m4a",
            "lent": "744368fd8570.m4a"
          }
        },
        {
          "id": "pag-56-b1-l7",
          "text": {
            "u": "אנחנו רוצים להיות אצל משפחת לוי."
          },
          "perComprovar": false,
          "audio": {
            "normal": "2f6a3b01cdda.m4a",
            "lent": "2f6a3b01cdda.m4a"
          }
        }
      ]
    },
