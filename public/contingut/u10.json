      "titol": {
        "u": "לִהְיוֹת — זמן עבר",
        "perComprovar": false,
        "ca": "זמן עבר — Ser/estar: el temps passat"
      },
      "tipus": "text",
      "linies": [
        {
          "id": "pag-55-b0-l0",
          "text": {
            "u": "הַמלט אומר: \"להיות, או לא להיות - זאת השאלה!\""
          },
          "perComprovar": false,
          "audio": {
            "normal": "43785a984194.m4a",
            "lent": "16edac175bfb.m4a"
          }
        },
        {
          "id": "pag-55-b0-l1",
          "text": {
            "u": "יוסף רוצה להיות בכיתה, אבל הוא צריך להיות במשׂרד."
          },
          "perComprovar": false,
          "audio": {
            "normal": "8571b8e629c9.m4a",
            "lent": "2065eb922fe3.m4a"
          }
        },
        {
          "id": "pag-55-b0-l2",
          "text": {
            "u": "התלמידים צריכים להיות בכיתה ב-8."
          },
          "perComprovar": false,
          "audio": {
            "normal": "cecd99b94a00.m4a",
            "lent": "16ec02c50457.m4a"
          }
        }
      ]
    },
    {
      "id": "pag-55-b1",
      "pagina": "pag-55",
      "titol": {
