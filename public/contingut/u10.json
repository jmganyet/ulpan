          "perComprovar": false,
          "audio": {
            "normal": "320bce050a90.m4a",
            "lent": "a3323bf2a4e2.m4a"
          }
        },
        {
          "id": "pag-56-b1-l5",
          "text": {
            "u": "הספר של יצחק אצל רוברטו."
          },
          "perComprovar": false,
          "audio": {
            "normal": "c04c5d2ad76d.m4a",
            "lent": "630b9cf95456.m4a"
          }
        },
        {
          "id": "pag-56-b1-l6",
          "text": {
            "u": "אתמול הן היו אצל חנה."
          },
          "perComprovar": false,
          "audio": {
            "normal": "8ebdcef2817c.m4a",
            "lent": "d72e68e8cfbd.m4a"
          }
        },
        {
          "id": "pag-56-b1-l7",
          "text": {
            "u": "אנחנו רוצים להיות אצל משפחת לוי."
